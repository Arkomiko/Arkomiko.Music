{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "install (если нужно)",
      "detail": "npm install, только если нет node_modules",
      "type": "process",
      "command": "node",
      "args": [
        "-e",
        "require('fs').existsSync('node_modules') || require('child_process').execSync('npm install', { stdio: 'inherit' })"
      ],
      "presentation": { "reveal": "silent" },
      "problemMatcher": []
    },
    { "label": "install", "type": "npm", "script": "install", "problemMatcher": [] },
    { "label": "dev", "type": "npm", "script": "dev", "isBackground": true, "problemMatcher": [] },
    {
      "label": "build",
      "type": "npm",
      "script": "build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    { "label": "preview", "type": "npm", "script": "preview", "isBackground": true, "problemMatcher": [] },
    { "label": "check", "type": "npm", "script": "check", "group": "test", "problemMatcher": [] },
    { "label": "format", "type": "npm", "script": "format", "problemMatcher": [] }
  ]
}
