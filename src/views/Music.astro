---
// «Музыка»: полный список треков (contents_user/traks/RLS и DR) с фильтром по статусу.
import Base from '../layouts/Base.astro';
import TrackTable from '../components/TrackTable.vue';
import { getLibrary } from '../lib/media';
import { localize, useT, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const library = await getLibrary();
---

<Base lang={lang} title={t('tracks.title')} description={t('tracks.lead')} active="music">
  <section class="container intro">
    <div class="eyebrow">{t('tracks.eyebrow')}</div>
    <h1 class="h1">{t('tracks.title')}</h1>
    <p class="lead">{t('tracks.lead')}</p>
    <p class="text-soft">
      {t('tracks.text')}{' '}
      <a href={localize('/licenses', lang)} class="link">
        {t('nav.licenses')}
      </a>
    </p>
    <div class="mono-label">{t('tracks.count', { n: library.length })}</div>
  </section>

  <section class="section">
    <div class="container block">
      <TrackTable client:load tracks={library} lang={lang} filters />
    </div>
  </section>
</Base>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding-block: 72px 56px;
  }
  .intro .lead {
    font-size: 20px;
    max-width: 760px;
  }
  .intro .text-soft {
    font-size: 16px;
    max-width: 760px;
  }
  .link {
    color: var(--accent-ink);
  }
  .block {
    padding-block: 56px 72px;
  }
  @media (max-width: 767px) {
    .intro {
      gap: 14px;
      padding-block: 25px 28px;
    }
    .intro .lead {
      font-size: 16px;
    }
    .intro .text-soft {
      font-size: 13px;
    }
    .block {
      padding-block: 22px 28px;
    }
  }
</style>
