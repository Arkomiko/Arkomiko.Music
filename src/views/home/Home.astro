---
// Главная: «Об авторе», «Последние релизы», «Треки».
import Base from '../../layouts/Base.astro';
import Logo from '../../components/ui/Logo.astro';
import ReleaseGrid from '../../components/catalog/ReleaseGrid.astro';
import TrackTable from '../../components/player/TrackTable.vue';
import EmptyState from '../../components/system/EmptyState.astro';
import { getCatalog, getLibrary, getPacks } from '../../lib/media';
import { clientKeys, localize, strings, useT, type Lang } from '../../lib/lang';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

const items = await getCatalog();
const packs = await getPacks();
const library = await getLibrary();
---

<Base lang={lang} active="home">
  <section id="about" class="container hero">
    <div class="hero-text">
      <div class="eyebrow">{t('home.eyebrow')}</div>
      <h1 class="logo-name hero-name">Arkomiko</h1>
      <p class="lead">{t('home.lead')}</p>
      <p class="text-soft desktop-only">{t('home.text')}</p>
      <p class="text-soft mobile-only">{t('home.textShort')}</p>
      <div class="hero-actions">
        <a href={localize('/about', lang)} class="btn btn-outline">
          {t('home.more')}
        </a>
        <a href={localize('/music', lang)} class="btn btn-primary">
          {t('home.library')}
        </a>
      </div>
    </div>
    <Logo variant="rotate" size={480} label={t('logo.alt')} class="hero-logo" />
  </section>

  <section id="releases" class="section">
    <div class="container block">
      <ReleaseGrid lang={lang} items={items} packs={packs} />
    </div>
  </section>

  <section id="tracks" class="section">
    <div class="container block">
      {library.length ? (
        <TrackTable
          client:visible
          tracks={library}
          lang={lang}
          t={strings(lang, clientKeys.trackTable)}
          title={t('home.tracks')}
          limit={6}
          seeAllHref={localize('/music', lang)}
        />
      ) : (
        <EmptyState lang={lang} kind="tracks" as="h2" />
      )}
    </div>
  </section>
</Base>

<style>
  @import './Home.css';
</style>
