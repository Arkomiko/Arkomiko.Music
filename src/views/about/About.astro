---
// «Об авторе»: биография, соцсети, «Чем занимаюсь», «Опыт», «Контакты».
import Base from '../../layouts/Base.astro';
import Logo from '../../components/ui/Logo.astro';
import { site, socialsFor } from '../../site.config';
import { localize, useT, type Lang } from '../../lib/lang';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

const socials = socialsFor(lang);
// Биография — несколько абзацев: в languages/ они разделены пустой строкой (\n\n).
const bio = t('about.bio').split('\n\n');

const doing = [
  { title: t('about.music'), text: t('about.musicText'), short: t('about.musicShort') },
  { title: t('about.voice'), text: t('about.voiceText'), short: t('about.voiceShort') },
  { title: t('about.animation'), text: t('about.animationText'), short: t('about.animationShort') },
  { title: t('about.video'), text: t('about.videoText'), short: t('about.videoShort') },
  { title: t('about.games'), text: t('about.gamesText'), short: t('about.gamesShort') },
  { title: t('about.translation'), text: t('about.translationText'), short: t('about.translationShort') },
  { title: t('about.code'), text: t('about.codeText'), short: t('about.codeShort') },
  { title: t('about.label'), text: t('about.labelText'), short: t('about.labelShort') },
];

// Опыт по годам: тексты — ключи about.exp1…exp11 (languages/); последний пункт — в планах («Скоро»).
// href — заголовок пункта становится ссылкой.
const experience = [
  { year: '2011', title: t('about.exp1'), text: t('about.exp1Text') },
  { year: '2016', title: t('about.exp2'), text: t('about.exp2Text') },
  { year: '2018', title: t('about.exp3'), text: t('about.exp3Text') },
  { year: '2019', title: t('about.exp4'), text: t('about.exp4Text') },
  { year: '2020', title: t('about.exp5'), text: t('about.exp5Text') },
  { year: '2021', title: t('about.exp6'), text: t('about.exp6Text') },
  { year: '2022', title: t('about.exp7'), text: t('about.exp7Text') },
  { year: '2023', title: t('about.exp8'), text: t('about.exp8Text') },
  { year: '2024', title: t('about.exp9'), text: t('about.exp9Text'), href: 'https://vk.ru/goliathchild' },
  { year: '2026', title: t('about.exp10'), text: t('about.exp10Text') },
  { year: t('about.year'), title: t('about.exp11'), text: t('about.exp11Text') },
];
const email = site.email || '[email]';
---

<Base lang={lang} title={t('nav.bio')} active="bio">
  <section class="container hero">
    <div class="hero-text">
      <div class="eyebrow">{t('nav.bio')}</div>
      <h1 class="logo-name hero-name">Arkomiko</h1>
      <p class="lead desktop-only">{t('about.lead')}</p>
      <p class="lead mobile-only">{t('about.leadShort')}</p>
      <div class="bio desktop-only">
        {bio.map((p) => (
          <p class="text-soft">{p}</p>
        ))}
      </div>
      <p class="text-soft mobile-only">{t('about.bioShort')}</p>
      <Logo variant="line" size={194} label={t('logo.alt')} class="logo-mobile" />
      <div class="socials">
        {socials.map((s) => (
          <a href={s.url} target="_blank" rel="me noopener">
            {s.label}
          </a>
        ))}
      </div>
    </div>
    <Logo variant="line" size={420} label={t('logo.alt')} class="logo-desktop" />
  </section>

  <section class="section">
    <div class="container block">
      <h2 class="h2">{t('about.doing')}</h2>
      <div class="doing">
        {doing.map((d) => (
          <div class="card doing-card">
            <h3 class="h3">{d.title}</h3>
            <p class="desktop-only">{d.text}</p>
            <p class="mobile-only">{d.short}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container block exp">
      <div class="exp-intro">
        <h2 class="h2">{t('about.experience')}</h2>
        <p class="desktop-only">{t('about.experienceText')}</p>
      </div>
      <ol class="timeline">
        {experience.map((e) => (
          <li>
            <div class="year">{e.year}</div>
            <div class="exp-body">
              <div class="exp-title">
                {e.href ? (
                  <a href={e.href} target="_blank" rel="noopener">
                    {e.title}
                  </a>
                ) : (
                  e.title
                )}
              </div>
              <div class="exp-text">{e.text}</div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="contacts" class="section">
    <div class="container block contacts">
      <div class="contacts-text">
        <h2 class="h2">{t('about.contacts')}</h2>
        <p class="text-soft">
          {t('about.contactsText')} {site.email ? <a href={`mailto:${site.email}`}>{email}</a> : email}
        </p>
      </div>
      <a href={localize('/music', lang)} class="btn btn-primary">
        {t('home.library')}
      </a>
    </div>
  </section>
</Base>

<style>
  @import './About.css';
</style>
