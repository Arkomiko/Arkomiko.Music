---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
---

<Base title="Обо мне">
  <div class="wrap">
    <h1 class="page-title">Обо мне</h1>
    <div class="prose">
      <p>Заглушка. Здесь будет текст о тебе: кто ты, что за музыку делаешь, с чего всё началось.</p>
      <p>
        Страница лежит в <code>src/pages/about.astro</code>, текст можно менять прямо в HTML.
      </p>
    </div>
    <h2 class="section-title more">Где ещё меня найти</h2>
    <ul class="plain">
      {site.socials.map((s) => (
        <li>
          <a href={s.url} target="_blank" rel="me noopener">
            {s.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .more {
    margin-top: 3rem;
  }
  .plain {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.4rem;
  }
  .plain a {
    color: var(--accent);
  }
</style>
