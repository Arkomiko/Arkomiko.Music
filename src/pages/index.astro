---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ReleaseGrid from '../components/ReleaseGrid.astro';
import DemoList from '../components/DemoList.astro';
import PlayButton from '../components/PlayButton.vue';
import { getItems, formatDate, toPlayerTracks } from '../lib/media';

const releases = await getItems('releases');
const demos = await getItems('demos');
const latest = releases[0];
const thumb = latest?.cover
  ? (await getImage({ src: latest.cover, width: 160, height: 160 })).src
  : undefined;
---

<Base accent={latest?.accent}>
  {latest && (
    <section class="latest">
      <div class="wrap latest-inner">
        <a href={latest.href} class="latest-cover">
          {latest.cover && (
            <Image
              src={latest.cover}
              alt={`Обложка: ${latest.title}`}
              width={640}
              height={640}
              loading="eager"
            />
          )}
        </a>
        <div>
          <p class="kind">Новый релиз</p>
          <h1 class="release-title">
            <a href={latest.href}>{latest.title}</a>
          </h1>
          <p class="muted meta">
            <span>{latest.typeLabel}</span>
            <time datetime={latest.date.toISOString()}>{formatDate(latest.date)}</time>
          </p>
          <div class="actions">
            <PlayButton client:load tracks={toPlayerTracks(latest, thumb)} />
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="wrap block">
    <div class="head">
      <h2 class="section-title">Релизы</h2>
      <a href="/releases">Все релизы</a>
    </div>
    <ReleaseGrid items={releases.slice(0, 8)} />
  </section>

  {demos.length > 0 && (
    <section class="wrap block">
      <div class="head">
        <h2 class="section-title">Техно-демки</h2>
        <a href="/demos">Все демки</a>
      </div>
      <DemoList items={demos.slice(0, 5)} />
    </section>
  )}
</Base>

<style>
  .latest {
    background: linear-gradient(180deg, color-mix(in oklab, var(--accent) 24%, var(--bg)) 0%, var(--bg) 100%);
    padding-block: clamp(2rem, 6vw, 5rem);
  }
  .latest-inner {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: end;
  }
  .latest-cover :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    box-shadow: 0 30px 60px -20px color-mix(in oklab, var(--accent) 45%, transparent);
  }
  .kind {
    margin: 0 0 0.75rem;
    color: var(--accent);
    font-weight: 600;
  }
  .release-title a {
    text-decoration: none;
  }
  .meta {
    display: flex;
    gap: 1.25rem;
    margin: 1.25rem 0 0;
  }
  .actions {
    margin-top: 2rem;
  }
  .block {
    margin-top: clamp(3rem, 7vw, 5rem);
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .head a {
    color: var(--muted);
  }
  .head a:hover {
    color: var(--text);
  }
  @media (max-width: 760px) {
    .latest-inner {
      grid-template-columns: 1fr;
    }
    .latest-cover {
      max-width: 420px;
    }
  }
</style>
