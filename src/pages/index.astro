---
import Home from '../views/home/Home.astro';
import Empty from '../views/system/Empty.astro';
import { emptyKind } from '../lib/media';

// Нет контента — вместо страницы показываем пустое состояние.
const kind = await emptyKind('home');
---

{kind ? <Empty lang="ru" kind={kind} active="home" /> : <Home lang="ru" />}
