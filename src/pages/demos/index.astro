---
import Base from '../../layouts/Base.astro';
import DemoList from '../../components/DemoList.astro';
import { getItems } from '../../lib/media';

const demos = await getItems('demos');
---

<Base title="Техно-демки" description="Черновики, наброски и техно-демки Arkomiko.">
  <div class="wrap">
    <h1 class="page-title">Техно-демки</h1>
    <p class="muted intro">Черновики и наброски. Некоторые потом становятся релизами.</p>
    {demos.length ? (
      <DemoList items={demos} />
    ) : (
      <p class="muted">Здесь появятся демки. Добавь папку в demos/.</p>
    )}
  </div>
</Base>

<style>
  .intro {
    margin: -1rem 0 2.5rem;
    max-width: 60ch;
  }
</style>
