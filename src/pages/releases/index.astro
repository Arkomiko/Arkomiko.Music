---
import Base from '../../layouts/Base.astro';
import ReleaseGrid from '../../components/ReleaseGrid.astro';
import { getItems } from '../../lib/media';

const items = await getItems('releases');
const filters = [
  { key: 'all', label: 'Все' },
  { key: 'album', label: 'Альбомы' },
  { key: 'ep', label: 'EP' },
  { key: 'single', label: 'Синглы' },
].filter((f) => f.key === 'all' || items.some((i) => 'type' in i.entry.data && i.entry.data.type === f.key));
---

<Base title="Релизы">
  <div class="wrap">
    <h1 class="page-title">Релизы</h1>
    {filters.length > 2 && (
      <div class="filters" role="group" aria-label="Тип релиза">
        {filters.map((f, i) => (
          <button type="button" data-filter={f.key} aria-pressed={i === 0 ? 'true' : 'false'}>
            {f.label}
          </button>
        ))}
      </div>
    )}
    <div data-grid>
      <ReleaseGrid items={items} />
    </div>
    {items.length === 0 && <p class="muted">Здесь появятся релизы. Добавь папку в releases/.</p>}
  </div>
</Base>

<script>
  function setup() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const cards = document.querySelectorAll<HTMLElement>('[data-grid] li');
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        const f = b.dataset.filter;
        cards.forEach((c) => {
          const t = c.querySelector<HTMLElement>('[data-type]')?.dataset.type;
          c.hidden = f !== 'all' && t !== f;
        });
      }),
    );
  }
  document.addEventListener('astro:page-load', setup);
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
  }
  .filters button {
    font: inherit;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }
  .filters button[aria-pressed='true'] {
    background: var(--text);
    border-color: var(--text);
    color: var(--bg);
  }
</style>
