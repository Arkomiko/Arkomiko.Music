---
import ReleaseView from '../../components/ReleaseView.astro';
import { getItems } from '../../lib/media';

export async function getStaticPaths() {
  const releases = await getItems('releases');
  const demos = await getItems('demos');
  return releases.map((item) => ({
    params: { slug: item.id },
    props: {
      item,
      sketches: demos.filter((d) => 'released_as' in d.entry.data && d.entry.data.released_as === item.id),
    },
  }));
}

const { item, sketches } = Astro.props;
---

<ReleaseView item={item} sketches={sketches} />
