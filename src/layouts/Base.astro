---
// Каркас каждой страницы: <head> (заголовок, описание, языки, тема), шапка, содержимое, подвал и плеер.
// Плеер живёт между переходами (ClientRouter + transition:persist), поэтому музыка не прерывается.
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header, { type NavKey } from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Player from '../components/player/Player.vue';
import { site } from '../site.config';
import { getLibrary } from '../lib/media';
import {
  clientKeys,
  coverage,
  defaultLang,
  langInfo,
  langs,
  localize,
  strings,
  stripLang,
  useT,
  type Lang,
} from '../lib/lang';
// Скрипты для <head>: выполняются до первой отрисовки, поэтому встраиваются в страницу как есть.
import themeScript from './head/theme.inline.js?raw';
import languageScript from './head/language.inline.js?raw';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  image?: string;
  active?: NavKey;
  /** Служебная страница: не индексировать поисковиками. */
  noindex?: boolean;
}

const { lang, title, image, active } = Astro.props;
const t = useT(lang);

// Язык, переведённый не полностью, не индексируется: вместо части текстов на нём подсказки шаблона.
const complete = (l: Lang) => coverage(l) === 1;
const noindex = Astro.props.noindex || !complete(lang);

const description = Astro.props.description ?? t('site.description');
const fullTitle = title ? `${title} | ${site.name}` : site.name;
const path = stripLang(Astro.url.pathname);
const library = await getLibrary();
const playerStrings = strings(lang, clientKeys.player);
const languageInit = languageScript
  .replaceAll('__LANGS__', JSON.stringify(langs))
  .replaceAll('__DEFAULT__', JSON.stringify(defaultLang));
---

<!doctype html>
<html lang={lang} dir={langInfo(lang).dir ?? 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Язык браузера при первом визите: до отрисовки, чтобы не мелькала русская версия. -->
    <script is:inline set:html={languageInit} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    {langs.filter(complete).map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(localize(path, l), Astro.site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(path, Astro.site)} />
    <!-- Иконка вкладки зависит от темы: в тёмной — светлая лиса, в светлой — чёрная. Меняет скрипт темы. -->
    <link rel="icon" href="/favicon-dark.ico" sizes="any" data-theme-icon />
    <!-- Тема до отрисовки, чтобы страница не мигала: выбор посетителя, иначе — как в системе. -->
    <script is:inline set:html={themeScript} />
    <ClientRouter />
  </head>
  <body>
    <Header lang={lang} active={active} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <!-- Подписи плеера на языке страницы: плеер живёт между переходами и перечитывает их отсюда. -->
    <script type="application/json" id="player-strings" set:html={JSON.stringify(playerStrings)} />
    <Player client:load library={library} t={playerStrings} transition:persist="player" />
  </body>
</html>
