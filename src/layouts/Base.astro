---
import '@fontsource-variable/unbounded';
import '@fontsource-variable/manrope';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header, { type NavKey } from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Player from '../components/Player.vue';
import { site } from '../site.config';
import { getLibrary } from '../lib/media';
import { langs, localize, stripLang, useT, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  image?: string;
  active?: NavKey;
  /** Служебная страница: не индексировать поисковиками. */
  noindex?: boolean;
}

const { lang, title, image, active, noindex } = Astro.props;
const t = useT(lang);
const description = Astro.props.description ?? t('site.description');
const fullTitle = title ? `${title} | ${site.name}` : site.name;
const path = stripLang(Astro.url.pathname);
const library = await getLibrary();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    {langs.map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(localize(path, l), Astro.site)} />
    ))}
    <!-- Иконка вкладки зависит от темы: в тёмной — светлая лиса, в светлой — чёрная. Меняет скрипт ниже. -->
    <link rel="icon" href="/favicon-dark.ico" sizes="any" data-theme-icon />
    <!-- Тема ставится до отрисовки, чтобы страница не мигала: выбор из localStorage, иначе — как в системе. -->
    <script is:inline>
      (() => {
        const setIcon = (doc) => {
          const icon = doc.querySelector('link[data-theme-icon]');
          if (icon) icon.href = `/favicon-${doc.documentElement.dataset.theme}.ico`;
        };
        const apply = (doc) => {
          let theme;
          try {
            theme = localStorage.getItem('theme');
          } catch {}
          if (theme !== 'light' && theme !== 'dark')
            theme = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          doc.documentElement.dataset.theme = theme;
          setIcon(doc);
        };
        apply(document);
        document.addEventListener('astro:before-swap', (e) => apply(e.newDocument));
        // Переключение темы кнопкой (шапка или полноэкранный плеер).
        document.addEventListener('themechange', () => setIcon(document));
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <Header lang={lang} active={active} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <Player client:load library={library} transition:persist="player" />
  </body>
</html>
