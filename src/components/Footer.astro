---
import { site } from '../site.config';
import { localize, useT, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
---

<footer class="site-footer section">
  <div class="container inner">
    <nav aria-label="Footer">
      {site.socials.map((s) => (
        <a href={s.url} target="_blank" rel="me noopener">
          {s.label}
        </a>
      ))}
      <a href={localize('/licenses', lang)}>{t('nav.licenses')}</a>
      <a href={localize('/about#contacts', lang)}>{t('nav.contacts')}</a>
    </nav>
    <div class="copy">
      © {new Date().getFullYear()} {site.name}
    </div>
  </div>
</footer>

<style>
  .inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 32px;
    padding-block: 32px;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .copy {
    flex: none;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }
  @media (max-width: 767px) {
    .inner {
      flex-direction: column;
      gap: 18px;
      padding-block: 22px 28px;
    }
    nav {
      gap: 10px 21px;
      font-size: 11px;
    }
    .copy {
      font-size: 11px;
    }
  }
</style>
