---
import { Image } from 'astro:assets';
import { formatDate, formatTime, type Item } from '../lib/media';

interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<ul class="list">
  {items.map((item) => {
    const total = item.tracks.reduce((s, t) => s + t.duration, 0);
    return (
      <li style={`--accent: ${item.accent}`}>
        <a href={item.href}>
          {item.cover && <Image src={item.cover} alt="" width={96} height={96} />}
          <span class="title">{item.title}</span>
          <span class="date muted">{formatDate(item.date)}</span>
          <span class="len muted">{formatTime(total)}</span>
        </a>
      </li>
    );
  })}
</ul>

<style>
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  li {
    border-bottom: 1px solid var(--line);
  }
  a {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 1.25rem;
    padding: 0.75rem 0.25rem;
    text-decoration: none;
  }
  a :global(img) {
    width: 48px;
    height: 48px;
    object-fit: cover;
  }
  .title {
    font-weight: 600;
  }
  a:hover .title {
    color: var(--accent);
  }
  .len {
    font-variant-numeric: tabular-nums;
    min-width: 3em;
    text-align: right;
  }
  @media (max-width: 560px) {
    .date {
      display: none;
    }
    a {
      grid-template-columns: 48px minmax(0, 1fr) auto;
    }
  }
</style>
