---
import { Image } from 'astro:assets';
import type { Item } from '../lib/media';

interface Props {
  item: Item;
}
const { item } = Astro.props;
const year = item.date.getFullYear();
---

<a
  class="card"
  href={item.href}
  style={`--accent: ${item.accent}`}
  data-type={'type' in item.entry.data ? item.entry.data.type : 'demo'}
>
  <div class="art">
    {item.cover ? <Image src={item.cover} alt="" width={480} height={480} /> : <div class="no-art" />}
  </div>
  <h3 class="title">{item.title}</h3>
  <p class="meta">
    <span>{item.typeLabel}</span>
    <span>{year}</span>
  </p>
</a>

<style>
  .card {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .art {
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--surface);
    outline: 2px solid transparent;
    outline-offset: 4px;
    transition: outline-color 0.2s;
  }
  .art :global(img),
  .no-art {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .no-art {
    background: linear-gradient(135deg, var(--surface), var(--accent));
  }
  .card:hover .art {
    outline-color: var(--accent);
  }
  .title {
    margin-top: 0.9rem;
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }
  .meta {
    display: flex;
    gap: 0.75rem;
    margin: 0.3rem 0 0;
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
