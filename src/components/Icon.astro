---
import { icons, iconAttrs, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}
const { name, size = 18, class: className } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  aria-hidden="true"
  class={className}
  {...iconAttrs(name)}
  set:html={icons[name].body}
/>
