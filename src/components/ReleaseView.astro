---
// Страница одного релиза или демки. Используется и в /releases/[slug], и в /demos/[slug].
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PlayButton from './PlayButton.vue';
import { formatDate, formatTime, toPlayerTracks, tracksLabel, type Item } from '../lib/media';
import { platformLabels } from '../site.config';

interface Props {
  item: Item;
  /** Ссылка «вышла как релиз» (для демки) */
  releasedAs?: Item;
  /** Демо-версии этого релиза */
  sketches?: Item[];
}

const { item, releasedAs, sketches = [] } = Astro.props;
const { Content } = await render(item.entry);
const data = item.entry.data;

const thumb = item.cover ? (await getImage({ src: item.cover, width: 160, height: 160 })).src : undefined;
const og = item.cover
  ? (await getImage({ src: item.cover, width: 1200, height: 1200, format: 'jpg' })).src
  : undefined;
const playerTracks = toPlayerTracks(item, thumb);
const total = item.tracks.reduce((s, t) => s + t.duration, 0);
const links = Object.entries(data.links ?? {});
---

<Base title={item.title} accent={item.accent} image={og}>
  <section class="hero">
    <div class="wrap hero-inner">
      <div class="cover">
        {item.cover ? (
          <Image src={item.cover} alt={`Обложка: ${item.title}`} width={720} height={720} loading="eager" />
        ) : (
          <div class="no-art" />
        )}
      </div>

      <div class="info">
        <p class="kind">{item.typeLabel}</p>
        <h1 class="release-title">{item.title}</h1>
        <p class="meta muted">
          <time datetime={item.date.toISOString()}>{formatDate(item.date)}</time>
          {item.tracks.length > 1 && <span>{tracksLabel(item.tracks.length)}</span>}
          {total > 0 && <span>{formatTime(total)}</span>}
        </p>

        <div class="actions">
          <PlayButton client:visible tracks={playerTracks} />
          {releasedAs && (
            <a class="ghost" href={releasedAs.href}>
              Вышло как релиз «{releasedAs.title}»
            </a>
          )}
        </div>

        {links.length > 0 && (
          <ul class="links" aria-label="Слушать на площадках">
            {links.map(([key, url]) => (
              <li>
                <a href={url} target="_blank" rel="noopener">
                  {platformLabels[key] ?? key}
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
  </section>

  <div class="wrap body">
    <section aria-labelledby="tracks-h">
      <h2 id="tracks-h" class="section-title">
        Треки
      </h2>
      {item.tracks.length ? (
        <ol class="tracks">
          {item.tracks.map((t, i) => (
            <li>
              <PlayButton client:visible tracks={playerTracks} start={i} variant="row" />
              <span class="n muted">{i + 1}</span>
              <span class="t">{t.title}</span>
              {data.download && (
                <a class="dl" href={t.src} download={t.file}>
                  Скачать mp3
                </a>
              )}
              <span class="d muted">{formatTime(t.duration)}</span>
            </li>
          ))}
        </ol>
      ) : (
        <p class="muted">Треки ещё не загружены: положи mp3 в папку tracks.</p>
      )}
    </section>

    <div class="side">
      <section class="prose">
        <Content />
      </section>

      {data.credits.length > 0 && (
        <section>
          <h2 class="section-title">Над релизом работали</h2>
          <ul class="plain">
            {data.credits.map((c) => (
              <li>{c}</li>
            ))}
          </ul>
        </section>
      )}

      {sketches.length > 0 && (
        <section>
          <h2 class="section-title">Ранние версии</h2>
          <ul class="plain">
            {sketches.map((s) => (
              <li>
                <a href={s.href}>{s.title}</a> <span class="muted">{formatDate(s.date)}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      <section class="license">
        <h2 class="section-title">Лицензия</h2>
        <p>
          {item.license.url ? (
            <a href={item.license.url} target="_blank" rel="noopener license">
              {item.license.name}
            </a>
          ) : (
            item.license.name
          )}
        </p>
      </section>
    </div>
  </div>
</Base>

<style>
  .hero {
    background: linear-gradient(180deg, color-mix(in oklab, var(--accent) 22%, var(--bg)) 0%, var(--bg) 100%);
    padding-block: clamp(2rem, 6vw, 4.5rem);
  }
  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: end;
  }
  .cover :global(img),
  .no-art {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    box-shadow: 0 30px 60px -20px color-mix(in oklab, var(--accent) 45%, transparent);
  }
  .no-art {
    background: linear-gradient(135deg, var(--surface), var(--accent));
  }
  .kind {
    margin: 0 0 0.75rem;
    color: var(--accent);
    font-weight: 600;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin: 1.25rem 0 0;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 2rem;
  }
  .ghost {
    color: var(--text);
    text-decoration-color: var(--accent);
    text-underline-offset: 4px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
  }
  .links a {
    display: inline-block;
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.9375rem;
  }
  .links a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: clamp(2rem, 6vw, 5rem);
    margin-top: 3rem;
  }
  .side {
    display: grid;
    gap: 2.5rem;
    align-content: start;
  }
  .side .section-title {
    font-size: 1.05rem;
    margin-bottom: 0.75rem;
  }

  .tracks {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .tracks li {
    display: grid;
    grid-template-columns: 36px 1.5rem minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--line);
  }
  .n,
  .d {
    font-variant-numeric: tabular-nums;
  }
  .t {
    font-weight: 500;
  }
  .dl {
    font-size: 0.875rem;
    color: var(--muted);
  }
  .dl:hover {
    color: var(--accent);
  }

  .plain {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.35rem;
  }
  .plain a,
  .license a {
    color: var(--accent);
  }
  .license p {
    margin: 0;
  }

  @media (max-width: 820px) {
    .hero-inner,
    .body {
      grid-template-columns: 1fr;
    }
    .cover {
      max-width: 420px;
    }
  }
</style>
